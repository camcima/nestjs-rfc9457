{
  "name": "@camcima/nestjs-rfc9457",
  "version": "0.3.1",
  "description": "NestJS library for RFC 9457 Problem Details responses",
  "author": "Carlos Cima",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "default": "./dist/swagger/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=test/unit",
    "test:e2e": "jest --testPathPatterns=test/e2e",
    "test:cov": "jest --coverage",
    "prepublishOnly": "pnpm run build",
    "release": "release-it",
    "audit:deps": "pnpm audit --prod",
    "audit:secrets": "gitleaks git --no-banner --redact -v"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/testing": "^11.1.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.2",
    "release-it": "^20.2.0",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp@<5.3.0": ">=5.3.0",
      "brace-expansion@5.0.5": "5.0.6",
      "fastify@<5.8.5": ">=5.8.5",
      "lodash@<4.18.0": ">=4.18.0",
      "path-to-regexp@<8.4.0": ">=8.4.0",
      "qs@6.15.1": "6.15.2",
      "undici@<6.24.0": ">=6.24.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/nestjs-rfc9457.git"
  },
  "keywords": [
    "nestjs",
    "rfc9457",
    "rfc7807",
    "problem-details",
    "error-handling",
    "api"
  ]
}

{
  "name": "@camcima/nestjs-rfc9457",
  "version": "0.5.0",
  "description": "NestJS library for RFC 9457 Problem Details responses",
  "author": "Carlos Cima",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "default": "./dist/swagger/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "release": "release-it",
    "audit:deps": "pnpm audit --prod",
    "audit:secrets": "gitleaks git --no-banner --redact -v"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "class-validator": "^0.14.0 || ^0.15.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.9.4",
    "reflect-metadata": "^0.2.2",
    "release-it": "^20.2.1",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "basic-ftp@<5.3.0": ">=5.3.0",
      "brace-expansion@5.0.5": "5.0.6",
      "fastify@<5.8.5": ">=5.8.5",
      "form-data@<4.0.6": "^4.0.6",
      "js-yaml@<4.2.0": "^4.2.0",
      "lodash@<4.18.0": ">=4.18.0",
      "multer@<2.2.0": "^2.2.0",
      "path-to-regexp@<8.4.0": ">=8.4.0",
      "qs@6.15.1": "6.15.2",
      "undici@<7.28.0": "^7.28.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/nestjs-rfc9457.git"
  },
  "keywords": [
    "nestjs",
    "rfc9457",
    "rfc7807",
    "problem-details",
    "error-handling",
    "api"
  ]
}
